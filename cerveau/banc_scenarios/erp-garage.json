    {"type": "module", "libelle": "ordres de réparation avec lignes et totaux", "motif": "ordre|reparation|^or$|^ors$", "document": true, "poids": 2},
    {"type": "module", "nom": "factures"},
    {"type": "texte", "libelle": "nom de l'application adapté au garage", "fichier": "app/config.py", "contient": ["garage"], "insensible_casse": true},
    {"type": "tests", "min": 39, "poids": 2},
